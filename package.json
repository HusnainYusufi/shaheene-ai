{
  "name": "shaheen-ai",
  "version": "0.1.0",
  "description": "AI verification service for Shaheen (Legend Sleep delivery): checks driver review screenshots",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node tests/rules.test.js && node tests/perceptualHash.test.js",
    "eval:extraction": "node evals/runExtractionEval.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"evals/**/*.js\"",
    "db:up": "docker compose up -d postgres"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HusnainYusufi/shaheene-ai.git"
  },
  "bugs": {
    "url": "https://github.com/HusnainYusufi/shaheene-ai/issues"
  },
  "homepage": "https://github.com/HusnainYusufi/shaheene-ai#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "license": "UNLICENSED"
}
