# --- Service ---
NODE_ENV=development
PORT=4100
# Shared secret legend-delivery sends in x-service-token (min 32 chars).
SERVICE_TOKEN=change-me-to-a-long-random-string-32chars

# --- Postgres (docker-compose.yml exposes it on 5433; pgAdmin UI on http://localhost:5050) ---
DATABASE_URL=postgres://shaheen:shaheen@localhost:5433/shaheen_ai

# --- legend-delivery internal API ---
LEGEND_DELIVERY_URL=http://localhost:3000
# Token this service sends to legend-delivery (min 32 chars).
LEGEND_DELIVERY_TOKEN=change-me-to-another-long-random-string

# --- LLM (vision + classification) ---
# minimax | anthropic
LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
# MiniMax-M3.1-Flash (cheapest, reads images) | MiniMax-M3
MINIMAX_MODEL=MiniMax-M3.1-Flash
# low | medium | high | xhigh | max  (Flash only; MiniMax's own default is max)
MINIMAX_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Embeddings ---
# local (on-machine, free, default) | voyage
# MiniMax has no embeddings API, so this is a separate choice from the LLM.
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Must match vector(N) in 002_embeddings.sql (multilingual-e5-small = 384).
EMBEDDING_DIM=384

# --- Pipeline tuning ---
# Comma-separated names the review must be about (Arabic and English).
BUSINESS_NAMES=legend sleep,ليجند سليب,ليجند
WORKER_CONCURRENCY=2
LLM_TIMEOUT_MS=60000
PHASH_MAX_DISTANCE=6
# Tuned for multilingual-e5-small (unrelated text still scores ~0.83)
TEXT_SIMILARITY_REVIEW=0.95
TEXT_SIMILARITY_REJECT=0.985
MAX_SUBMIT_DELAY_DAYS=14
